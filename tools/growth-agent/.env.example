# Set these as environment variables before running server.py.
# This file is a reference; server.py does NOT load .env automatically.
GROWTH_PASSWORD=choose-a-long-private-password
PORT=8787
# Optional Groq AI generation. Choose an available JSON-mode capable model.
GROQ_API_KEY=
GROQ_MODEL=
# Optional paid public-web research. No social profile scraping.
BRAVE_SEARCH_API_KEY=
# Optional Instagram API with Instagram Login, NOT Facebook Login tokens.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=
# Only enable after reviewing the code and connecting your own account.
ENABLE_LIVE_PUBLISHING=false
